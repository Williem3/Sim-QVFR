{
  "name": "Sim-QVFR Launcher, Bauhaus x Flat",
  "version": 3,
  "about": "The launcher's design tokens (docs/ui/OVERHAUL_PLAN.md). tools/gen_launcher_theme.py turns them into src/launcher/ui/theme_tokens.h and docs/ui/tokens.css. Colour always means something: blue is Picture and selection, red is Headset and the Launch button, yellow is Game and the selected game. Text pairs meet 4.5:1 and control edges 3:1 in both themes.",
  "color": {
    "themes": [{ "id": "light", "name": "Light" }, { "id": "dark", "name": "Dark" }],
    "tokens": [
      { "name": "bg", "value": { "light": "#F4F2EE", "dark": "#121317" }, "usage": "Window background behind the cards." },
      { "name": "surface", "value": { "light": "#FFFFFF", "dark": "#1B1D22" }, "usage": "Cards, bars, menus and sheets." },
      { "name": "surface-2", "value": { "light": "#EDEAE4", "dark": "#262930" }, "usage": "Segmented tracks, chips, secondary buttons." },
      { "name": "surface-3", "value": { "light": "#E2DFD8", "dark": "#2E3138" }, "usage": "A secondary button or chip under the pointer." },
      { "name": "line", "value": { "light": "#E2DFD8", "dark": "#2E3138" }, "usage": "Dividers and card edges only (1.3:1: never a control's edge)." },
      { "name": "text", "value": { "light": "#16181D", "dark": "#F2F1EE" }, "usage": "Primary text." },
      { "name": "text-muted", "value": { "light": "#5B5F68", "dark": "#A3A6AE" }, "usage": "Help text, labels, units." },
      { "name": "text-disabled", "value": { "light": "#9A9DA4", "dark": "#62656D" }, "usage": "A control that can't be used right now (exempt from contrast)." },
      { "name": "rail", "value": { "light": "#16181D", "dark": "#0A0B0D" }, "usage": "The game rail, dark in both themes." },
      { "name": "rail-text", "value": { "light": "#F2F1EE", "dark": "#F2F1EE" }, "usage": "Text on the rail." },
      { "name": "rail-text-muted", "value": { "light": "#A3A6AE", "dark": "#A3A6AE" }, "usage": "Game names and the version on the rail (7.3:1)." },
      { "name": "blue", "value": { "light": "#1F4FD1", "dark": "#3A64E8" }, "usage": "Picture, selection, slider fill, switches on, primary buttons." },
      { "name": "blue-text", "value": { "light": "#1F4FD1", "dark": "#8FAAFF" }, "usage": "Blue used as text or a thin mark." },
      { "name": "on-blue", "value": { "light": "#FFFFFF", "dark": "#FFFFFF" }, "usage": "Text on blue." },
      { "name": "red", "value": { "light": "#D7261B", "dark": "#D7261B" }, "usage": "Headset, and the Launch button: the only red action." },
      { "name": "on-red", "value": { "light": "#FFFFFF", "dark": "#FFFFFF" }, "usage": "Text on red (5.0:1)." },
      { "name": "yellow", "value": { "light": "#F5C518", "dark": "#F5C518" }, "usage": "Game, and the selected game. Never alone for a state on a light surface (1.6:1)." },
      { "name": "ink", "value": { "light": "#16181D", "dark": "#16181D" }, "usage": "Text on yellow (10.9:1)." },
      { "name": "green-text", "value": { "light": "#157347", "dark": "#6FDCA0" }, "usage": "Status only: Ready, Live." },
      { "name": "green-bg", "value": { "light": "#E3F4EA", "dark": "#1E352C" }, "usage": "Behind green status text (dark: rgba(46,160,90,.18) on surface)." },
      { "name": "warn-text", "value": { "light": "#6B4E00", "dark": "#F5D76E" }, "usage": "Warnings." },
      { "name": "warn-bg", "value": { "light": "#FFF1BF", "dark": "#3E3820" }, "usage": "Behind warnings (dark: rgba(245,197,24,.16) on surface)." },
      { "name": "danger-text", "value": { "light": "#B3261E", "dark": "#FF8F85" }, "usage": "Errors and problems." },
      { "name": "danger-bg", "value": { "light": "#FDE7E4", "dark": "#3D1F21" }, "usage": "Behind errors (dark: the red at 18% on surface)." },
