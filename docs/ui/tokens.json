      { "name": "preview-focus", "value": { "light": "#3A4F8F", "dark": "#3A4F8F" }, "usage": "The focus region in the preview (blue: Picture)." },
      { "name": "preview-label", "value": { "light": "#F2F1EE", "dark": "#F2F1EE" }, "usage": "Text and marks in the preview." },
      { "name": "overlay-teal", "value": { "light": "#0E8A9E", "dark": "#40C8E0" }, "usage": "The in-headset outline colours, as swatches." },
      { "name": "overlay-magenta", "value": { "light": "#C026B8", "dark": "#F272E6" }, "usage": "As above." },
      { "name": "overlay-green", "value": { "light": "#1F8A3C", "dark": "#4CD964" }, "usage": "As above." },

      { "name": "window-bg", "alias": true, "value": "{bg}", "usage": "Legacy name (the old kit), until every page uses the names above." },
      { "name": "sidebar-bg", "alias": true, "value": "{surface}", "usage": "Legacy." },
      { "name": "titlebar-bg", "alias": true, "value": "{surface}", "usage": "Legacy." },
      { "name": "group-bg", "alias": true, "value": "{surface}", "usage": "Legacy." },
      { "name": "card-border", "alias": true, "value": "{line}", "usage": "Legacy." },
      { "name": "control-bg", "alias": true, "value": "{surface-2}", "usage": "Legacy." },
      { "name": "control-hover", "alias": true, "value": "{surface-3}", "usage": "Legacy." },
      { "name": "field-bg", "alias": true, "value": "{surface}", "usage": "Legacy." },
