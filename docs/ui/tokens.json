      { "name": "accent", "alias": true, "value": "{blue-text}", "usage": "Legacy." },
      { "name": "accent-fill", "alias": true, "value": "{blue}", "usage": "Legacy." },
      { "name": "on-accent", "alias": true, "value": "{on-blue}", "usage": "Legacy." },
      { "name": "support-fill", "alias": true, "value": "{red}", "usage": "Legacy: the Ko-fi heart's circle." },
      { "name": "sidebar-selection", "alias": true, "value": "{blue}", "usage": "Legacy." },
      { "name": "focus-ring", "alias": true, "value": "{focus}", "usage": "Legacy." },
      { "name": "success", "alias": true, "value": "{green-text}", "usage": "Legacy." },
