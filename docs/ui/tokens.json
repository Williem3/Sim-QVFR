      { "name": "value", "family": "inter", "fontSize": "13px", "lineHeight": "18px", "fontWeight": 600, "tabular": true, "usage": "Readouts and slider values (tabular figures)." },
      { "name": "badge", "family": "inter", "fontSize": "12px", "lineHeight": "16px", "fontWeight": 600, "usage": "Status badges and chips." },
      { "name": "button", "family": "inter", "fontSize": "14px", "lineHeight": "20px", "fontWeight": 500, "usage": "Button labels." },
      { "name": "rail-name", "family": "inter", "fontSize": "11px", "lineHeight": "13px", "fontWeight": 500, "usage": "A game's full name under its abbreviation." }
