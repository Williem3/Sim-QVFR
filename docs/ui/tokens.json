      { "name": "knob", "value": { "light": "#FFFFFF", "dark": "#FFFFFF" }, "usage": "Switch knobs and slider thumbs." },
      { "name": "focus", "value": { "light": "#1F4FD1", "dark": "#8FAAFF" }, "usage": "The keyboard focus ring (6:1 on bg)." },
      { "name": "segment-on", "value": { "light": "#16181D", "dark": "#F2F1EE" }, "usage": "The selected segment of a segmented control." },
      { "name": "on-segment", "value": { "light": "#FFFFFF", "dark": "#1B1D22" }, "usage": "Text on the selected segment." },
